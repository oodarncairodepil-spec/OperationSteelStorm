; Engine configuration file.
; Operation Steelstorm — temporary working title (easy to replace later).
; Target engine: Godot 4.5 stable (Compatibility / GL Compatibility renderer).
; Format: [section] param=value

config_version=5

[application]

config/name="Operation Steelstorm"
config/description="Original browser-based 2D arcade run-and-gun cooperative multiplayer game."
config/version="0.4.0-phase4"
run/main_scene="res://scenes/ui/boot_test.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://autoload/scene_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[physics]

common/physics_ticks_per_second=60

